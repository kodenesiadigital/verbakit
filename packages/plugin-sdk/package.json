{
  "name": "@pressforge/plugin-sdk",
  "version": "0.1.0",
  "description": "SDK untuk menulis plugin PressForge (mirip WordPress Plugin API).",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://pressforge.my.id",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-package.mjs . @pressforge/core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pressforge/core": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
