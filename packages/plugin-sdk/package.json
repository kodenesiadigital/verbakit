{
  "name": "@kodenesiadigital/verbakit-plugin-sdk",
  "version": "0.1.0",
  "description": "SDK untuk menulis plugin Verbakit (mirip WordPress Plugin API).",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://verbakit.my.id",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-package.mjs . @kodenesiadigital/verbakit-core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kodenesiadigital/verbakit-core": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verbakit/verbakit.git"
  },
  "bugs": {
    "url": "https://github.com/verbakit/verbakit/issues"
  },
  "author": {
    "name": "verbakit"
  }
}
