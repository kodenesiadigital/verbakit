# sengaja ikut commit sebagai template.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key

# ---------- Cloudflare / Wrangler ----------
.wrangler/
wrangler/state/
worker-status/
*.worker-status

# ---------- Database lokal (D1 & KV SQLite) ----------
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# ---------- Log & cache ----------
*.log
npm-debug.log*
yarn-error.log*
.cache/
.vite/

# ---------- Test & coverage ----------
coverage/
.nyc_output/

# ---------- Editor / OS ----------
.DS_Store
Thumbs.db
