{
  "name": "pressforge",
  "private": true,
  "version": "0.1.0",
  "description": "WordPress-like CMS, fully on Cloudflare (Workers + D1 + R2 + KV), plugin-extensible.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://pressforge.my.id",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cms",
    "cloudflare-workers",
    "d1",
    "r2",
    "headless",
    "plugin-system"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build:registry": "node scripts/generate-registry.mjs",
    "build:core": "npm run build -w @pressforge/core",
    "build:sdk": "npm run build -w @pressforge/plugin-sdk",
    "build:packages": "npm run build:core && npm run build:sdk",
    "build:admin": "npm run build -w @pressforge/admin",
    "build": "npm run build:registry && npm run build:packages && npm run typecheck && npm run build:admin",
    "deploy": "npm run build && npm run deploy -w @pressforge/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "predev:api": "npm run build:packages",
    "dev:api": "npm run dev -w @pressforge/api",
    "dev:admin": "npm run dev -w @pressforge/admin"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "workerd@1.20260925.1": true,
    "sharp@0.35.4": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prorstun/pressforge.git"
  },
  "bugs": {
    "url": "https://github.com/prorstun/pressforge/issues"
  },
  "author": {
    "name": "prorstun"
  }
}
